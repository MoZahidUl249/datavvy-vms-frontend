# Local settings for run-web.command and build-web.command. Copy to `.env`
# (git-ignored). Netlify doesn't use this file: set the same variable in the
# site's environment variables.

# API base URL baked into the app (must end in /api).
#   local backend:  http://localhost:8080/api   (default when unset)
#   deployed API:   https://<service>.onrender.com/api
# VMS_API_BASE_URL='https://<service>.onrender.com/api'
